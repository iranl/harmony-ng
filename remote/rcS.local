#!/bin/sh
# Harmony Remote Boot Script (/etc/init.d/rcS.local)
# Automatic reboot recovery + USB Ethernet + Dropbear SSH
PATH=/data:/bin:/sbin:/usr/bin:/usr/sbin
export PATH

sync_fs() {
    /data/remote_sync 2>/dev/null || /data/sync 2>/dev/null || sync 2>/dev/null || true
}

# 0. Early watchdog neuter and neuter stock binaries
[ -f /etc/nowatchdog ] || touch /etc/nowatchdog 2>/dev/null || true
if [ -x /usr/bin/watchdog ]; then
    chmod -x /usr/bin/watchdog /usr/bin/hal /opt/luaworks/luaworks /opt/luadraws/luadraws 2>/dev/null || true
fi
killall -9 watchdog usbhid hal luaworks luadraws lua luajit luajit-2.0.0-beta10 2>/dev/null || true

# 1. Ensure clean boot state
rm -f /tmp/remote_stop /tmp/elite_stop /data/reboot_counter 2>/dev/null || true

# 2. Ensure /dev/i2c-1 exists for Clearpad touchscreen & MSP430 RTC
if [ ! -e /dev/i2c-1 ] && [ -x /data/mknod ]; then
    /data/mknod /dev/i2c-1 c 89 1 2>/dev/null || true
fi

# 3. Ensure sync binary and extended BusyBox applets are symlinked
SYNC_BIN=""
for b in /data/remote_sync /data/elite_sync; do
    if [ -x "$b" ]; then SYNC_BIN="$b"; break; fi
done
if [ -n "$SYNC_BIN" ]; then
    [ -e /data/sync ] || ln -sf "$SYNC_BIN" /data/sync 2>/dev/null || true
    [ -e /usr/bin/sync ] || ln -sf "$SYNC_BIN" /usr/bin/sync 2>/dev/null || true
fi

if [ -x /data/busybox ] && [ ! -L /usr/bin/head ]; then
    for applet in head tail which find tar xargs xz bzcat bunzip2 lzma unlzma diff patch awk sed; do
        ln -sf /data/busybox "/usr/bin/$applet" 2>/dev/null || true
    done
fi

# 4. Bring up USB Ethernet & Dropbear SSH in background if USB connected
chmod -x /usr/bin/usbhid 2>/dev/null || true
POWERSOURCE="$(cat /sys/devices/platform/i2c_davinci.1/i2c-1/1-0048/tps6507x-juniper/powersource 2>/dev/null)"
if [ "$POWERSOURCE" = "usb" ] || [ -z "$POWERSOURCE" ]; then
    if [ ! -d /sys/class/net/usb0 ]; then
        /usr/bin/usbeth start &
    fi
    if ! pidof dropbear >/dev/null 2>&1 && ! pidof dropbearmulti >/dev/null 2>&1; then
        if [ -x /data/dropbearmulti ]; then
            /data/dropbearmulti dropbear -R -p 0.0.0.0:22 2>/dev/null &
        elif [ -x /data/dropbear ]; then
            /data/dropbear -R -p 0.0.0.0:22 2>/dev/null &
        elif [ -x /usr/sbin/dropbear ]; then
            /usr/sbin/dropbear -R -p 0.0.0.0:22 2>/dev/null &
        fi
    fi
fi

# 5. Launch custom remote runtime supervisor in background
if [ -x /data/init.sh ]; then
    /data/init.sh start &
elif [ -x /data/remote_watchdog.sh ]; then
    /data/remote_watchdog.sh &
elif [ -x /data/remote_ui ]; then
    /data/remote_ui > /tmp/remote_ui.log 2>&1 &
elif [ -x /data/elite_ui ]; then
    /data/elite_ui > /tmp/remote_ui.log 2>&1 &
fi
