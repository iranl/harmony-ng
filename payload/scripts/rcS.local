#!/bin/sh

sync_fs() {
	/data/harmony/bin/hub_sync 2>/dev/null || /cache/bin/sync 2>/dev/null || sync 2>/dev/null || true
}

# 0. Neuter watchdog and luaworks immediately
touch /etc/nowatchdog 2>/dev/null || true
chmod -x /usr/bin/watchdog /opt/luaworks/luaworks 2>/dev/null || true
killall -9 watchdog 2>/dev/null || true

# SSH: the stock boot script starts /usr/sbin/dropbear right after this file (the emergency mode
# below starts it too). It becomes a copy of /data/harmony/hub_sshd (key logins only), written
# only when it differs; a copy, not a link, so it does not depend on /data/harmony later. Only the
# stock BusyBox applets are used here (no readlink, no cmp).
_sshd_src=/data/harmony/hub_sshd
_sshd_bin=""
if [ -s "$_sshd_src" ] && grep -q '^# harmony-ng hub_sshd$' "$_sshd_src" 2>/dev/null; then
	_sshd_bin=$(sh "$_sshd_src" --binary 2>/dev/null)
fi
if [ -n "$_sshd_bin" ] && [ -x "$_sshd_bin" ]; then
	_sshd_cur=""
	[ -f /usr/sbin/dropbear ] && [ ! -L /usr/sbin/dropbear ] && _sshd_cur=$(cat /usr/sbin/dropbear 2>/dev/null)
	if [ "$_sshd_cur" != "$(cat "$_sshd_src")" ]; then
		cp "$_sshd_src" /usr/sbin/dropbear.new 2>/dev/null && chmod 755 /usr/sbin/dropbear.new &&
			mv -f /usr/sbin/dropbear.new /usr/sbin/dropbear
	fi
elif [ ! -s /usr/sbin/dropbear ]; then
	_fb=""
	if [ -x /data/harmony/bin/dropbearmulti ] && [ -s /data/harmony/bin/dropbearmulti ]; then
		_fb=/data/harmony/bin/dropbearmulti
	elif [ -x /data/dropbearmulti ] && [ -s /data/dropbearmulti ]; then
		_fb=/data/dropbearmulti
	fi
	if [ -n "$_fb" ]; then
		printf '#!/bin/sh\nexec %s dropbear -s -g -K 300 "$@"\n' "$_fb" > /usr/sbin/dropbear.new &&
			chmod 755 /usr/sbin/dropbear.new && mv -f /usr/sbin/dropbear.new /usr/sbin/dropbear
	fi
fi

# 1. Reboot counter emergency check
COUNT=0
REBOOT_FILE="/data/harmony/reboot_counter"
if [ -f "$REBOOT_FILE" ]; then
	COUNT=$(cat "$REBOOT_FILE" 2>/dev/null || echo 0)
fi
COUNT=$(expr "$COUNT" + 1 2>/dev/null || echo 1)
mkdir -p /data/harmony 2>/dev/null || true
echo "$COUNT" > /data/harmony/reboot_counter
sync_fs

# 3. Emergency recovery condition (>5 consecutive unverified boots)
if [ "$COUNT" -gt 5 ]; then
	echo "$(date) EMERGENCY RECOVERY MODE: $COUNT failed boots. WiFi and Dropbear SSH only." > /tmp/emergency_recovery.log

	# init.sh, whose timer resets the counter, does not run in this mode: without this the
	# counter only grows and every later boot is an emergency boot. One emergency boot at a
	# time, then two normal tries before the next one.
	echo 3 > "$REBOOT_FILE"
	sync_fs

	# Initialize WLAN, wpa_supplicant, and background DHCP
	load_modules /etc/modules.wlan 2>/dev/null || true
	/sbin/wlanconfig ath0 create wlandev wifi0 wlanmode sta 2>/dev/null || true
	/usr/sbin/wpa_supplicant -s -iath0 -c /etc/wpa_supplicant.conf &
	# pid file: a Wi-Fi set over USB asks this udhcpc for a new lease (SIGUSR1)
	udhcpc -i ath0 -p /var/run/udhcpc.ath0.pid -b 2>/dev/null &

	# Ensure pristine stock SquashFS /bin/sh and /bin/busybox are NEVER shadowed on unionfs
	rm -f /data/bin/sh /data/bin/ash /data/bin/busybox 2>/dev/null || true
	if [ -x /cache/bin/busybox ]; then
		/cache/bin/busybox --install -s /cache/bin 2>/dev/null || true
	fi
	mkdir -p /etc/profile.d 2>/dev/null || true
	echo 'export PATH=/cache/bin:/data/harmony/bin:$PATH' > /etc/profile.d/00-harmony.sh 2>/dev/null || true
	chmod 644 /etc/profile.d/00-harmony.sh 2>/dev/null || true

	for prof in /root/.profile /home/root/.profile; do
		mkdir -p "$(dirname "$prof")" 2>/dev/null || true
		cat <<'EOF' > "$prof"
BB_PATH=""
if [ -x /cache/bin/busybox ]; then
    BB_PATH=/cache/bin/busybox
elif [ -x /cache/busybox ]; then
    BB_PATH=/cache/busybox
fi
if [ -t 0 ] && [ -n "$BB_PATH" ] && [ -z "$BB_EXTENDED" ]; then
    export BB_EXTENDED=1
    export PATH=/cache/bin:/data/harmony/bin:$PATH
    exec "$BB_PATH" sh -l
fi
export PATH=/cache/bin:/data/harmony/bin:$PATH
EOF
		chmod 644 "$prof" 2>/dev/null || true
	done

	# Wi-Fi setup over USB (see init.sh 5.1): the stock boot script ends with this file in this
	# mode, before it would start usbhid, so both are started here. The port stays a USB device.
	# Not when USB_WIFI_SETUP=0 is in ethernet.conf (the setting is off).
	if [ -x /data/harmony/bin/hub_util ] &&
		! tr -d ' \t"\r' < /data/harmony/ethernet.conf 2>/dev/null | grep -q '^USB_WIFI_SETUP=0$'; then
		/data/harmony/bin/hub_util usbwifi >> /tmp/emergency_recovery.log 2>&1 &
		[ -x /usr/bin/usbhid ] && /usr/bin/usbhid -s &
	fi

	# Start Dropbear SSH, key logins only (/usr/sbin/dropbear is set above; the server binary
	# directly when that file is not usable)
	if [ -s /usr/sbin/dropbear ] && [ -x /usr/sbin/dropbear ]; then
		/usr/sbin/dropbear
	elif [ -x /data/harmony/bin/dropbearmulti ] && [ -s /data/harmony/bin/dropbearmulti ]; then
		/data/harmony/bin/dropbearmulti dropbear -s -g -K 300
	elif [ -x /data/dropbearmulti ] && [ -s /data/dropbearmulti ]; then
		/data/dropbearmulti dropbear -s -g -K 300
	fi

	exit 0
fi

# 4. Normal Boot: start core services and Dropbear SSH immediately
if [ -x /data/harmony/init.sh ]; then
	/data/harmony/init.sh &
fi

# Ensure ifup -a does not spawn an unmanaged rogue udhcpc on ath0
if grep -q 'auto.*ath0' /etc/network/interfaces 2>/dev/null; then
	sed -i 's/auto.*ath0/auto lo/' /etc/network/interfaces 2>/dev/null || true
fi

# Initialize WLAN and wpa_supplicant (Networking managed by network_manager)
load_modules /etc/modules.wlan 2>/dev/null || true
/sbin/wlanconfig ath0 create wlandev wifi0 wlanmode sta 2>/dev/null || true
/usr/sbin/wpa_supplicant -s -iath0 -c /etc/wpa_supplicant.conf &

# Kernel overcommit
echo 1 > /proc/sys/vm/overcommit_memory

# Hardware version & Bluetooth (skip if Bluetooth disabled)
BT_DIS="/data/harmony/bt_disabled.conf"
if [ ! -f "$BT_DIS" ]; then
(
	MFG_DATA=/dev/$(grep mfg /proc/mtd | cut -d: -f1)
	HW_VERSION=$(sed -n '/hw_ver/{N N N N s/^[^0-9]*\([0-9][0-9]\)/\1/p}' $MFG_DATA 2>/dev/null)

	BUILDNAME=$(/usr/sbin/bccmd -t bcsp buildname 2>/dev/null)
	case "$BUILDNAME" in
		*A06*) PSKEYS=csr8811-a06.psr ;;
		*A08*) case "$HW_VERSION" in
			00.40) PSKEYS=csr8811-a08-pb1.psr ;;
			*)     PSKEYS=csr8811-a08.psr ;;
		       esac ;;
		*) exit 0 ;;
	esac

	[ -f "/lib/firmware/$PSKEYS" ] || exit 0
	cat /lib/firmware/$PSKEYS > /tmp/pskeys.psr

	for i in 1 2 3 4 5; do
		if [ -f /sys/class/net/ath0/address ]; then break; fi
		sleep 1
	done

	cat /sys/class/net/ath0/address 2>/dev/null | sed 's/\([0-9a-f][0-9a-f]\):\([0-9a-f][0-9a-f]\):\([0-9a-f][0-9a-f]\):\([0-9a-f][0-9a-f]\):\([0-9a-f][0-9a-f]\):\([0-9a-f][0-9a-f]\).*/\&0x0001 = 0x\4 0x\5\6 0x\3 0x\1\2/' >> /tmp/pskeys.psr

	/usr/sbin/bccmd -t bcsp psload -r /tmp/pskeys.psr 2>/dev/null
	/usr/sbin/hciattach ttyS0 bcsp 2>/dev/null
	/usr/sbin/hciconfig hci0 up 2>/dev/null
	/usr/sbin/hciconfig hci0 sspmode 1 2>/dev/null
) &
else
	echo "$(date) Bluetooth disabled in config, skipping hardware init" >> /tmp/harmony-boot.log
fi
