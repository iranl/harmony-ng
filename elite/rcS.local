#!/bin/sh
# Harmony Elite Boot Script (/etc/init.d/rcS.local)
# Automatic reboot recovery + USB Ethernet + Dropbear SSH

sync_fs() {
    /data/elite_sync 2>/dev/null || /data/sync 2>/dev/null || sync 2>/dev/null || true
}

# 0. Early watchdog neuter and neuter stock binaries
[ -f /etc/nowatchdog ] || touch /etc/nowatchdog 2>/dev/null || true
if [ -x /usr/bin/watchdog ]; then
    chmod -x /usr/bin/watchdog /usr/bin/hal /opt/luaworks/luaworks /opt/luadraws/luadraws 2>/dev/null || true
fi
killall -9 watchdog usbhid hal luaworks luadraws lua luajit luajit-2.0.0-beta10 2>/dev/null || true

# 1. Reboot counter check
COUNT=0
if [ -f /data/reboot_counter ]; then
    COUNT=$(cat /data/reboot_counter 2>/dev/null || echo 0)
fi
COUNT=$(expr "$COUNT" + 1 2>/dev/null || echo 1)
echo "$COUNT" > /data/reboot_counter
sync_fs

# 2. 5-minute stability timer in background
(
    sleep 300
    if [ -f /data/reboot_counter ] && [ "$(cat /data/reboot_counter 2>/dev/null)" != "0" ]; then
        echo 0 > /data/reboot_counter
        sync_fs
    fi
    echo "$(date) Elite uptime > 5m achieved, reboot counter reset" >> /tmp/boot_stability.log
) &

# 3. Emergency recovery condition (>5 consecutive failed boots)
if [ "$COUNT" -gt 5 ]; then
    echo "$(date) EMERGENCY RECOVERY MODE: $COUNT failed boots. USB Ethernet and SSH only." > /tmp/emergency_recovery.log
    chmod -x /usr/bin/usbhid 2>/dev/null || true
    /usr/bin/usbeth start 2>/dev/null || true
    if [ -x /data/dropbear ]; then
        /data/dropbear -R -p 0.0.0.0:22 2>/dev/null || /data/dropbear -R -B
    elif [ -x /usr/sbin/dropbear ]; then
        /usr/sbin/dropbear -R -p 0.0.0.0:22 2>/dev/null || /usr/sbin/dropbear -R -B
    fi
    exit 0
fi

# 4. Normal Boot: USB Ethernet & Dropbear SSH active by default on USB
USBETH_CONF=1
ELITE_CONF="/data/elite_settings.conf"
if [ -f "$ELITE_CONF" ]; then
    VAL=$(grep '^usbeth=' "$ELITE_CONF" 2>/dev/null | cut -d= -f2)
    if [ "$VAL" = "0" ]; then USBETH_CONF=0; fi
fi

PSRC=$(cat /sys/devices/platform/i2c_davinci.1/i2c-1/1-0048/tps6507x-juniper/powersource 2>/dev/null || echo "usb")

if [ "$USBETH_CONF" = "1" ] || [ "$PSRC" = "usb" ]; then
    chmod -x /usr/bin/usbhid 2>/dev/null || true
    /usr/bin/usbeth start 2>/dev/null || true
    if [ -x /data/dropbear ]; then
        /data/dropbear -R -p 0.0.0.0:22 2>/dev/null || /data/dropbear -R -B
    elif [ -x /usr/sbin/dropbear ]; then
        /usr/sbin/dropbear -R -p 0.0.0.0:22 2>/dev/null || /usr/sbin/dropbear -R -B
    fi
fi

SYNC_BIN=""
for b in /data/elite_sync; do
    if [ -x "$b" ]; then SYNC_BIN="$b"; break; fi
done
if [ -n "$SYNC_BIN" ]; then
    [ -e /data/sync ] || ln -sf "$SYNC_BIN" /data/sync 2>/dev/null || true
    [ -e /usr/bin/sync ] || ln -sf "$SYNC_BIN" /usr/bin/sync 2>/dev/null || true
fi

# Ensure /dev/i2c-1 exists for Clearpad touchscreen
if [ ! -e /dev/i2c-1 ] && [ -x /data/mknod ]; then
    /data/mknod /dev/i2c-1 c 89 1 2>/dev/null || true
fi

# Ensure extended BusyBox utilities are available in standard PATH
if [ -x /data/busybox ] && [ ! -L /usr/bin/head ]; then
    for applet in head tail which find tar xargs xz bzcat bunzip2 lzma unlzma diff patch awk sed; do
        ln -sf /data/busybox "/usr/bin/$applet" 2>/dev/null || true
    done
fi

# 5. Launch custom Elite runtime
if [ -x /data/init.sh ]; then
    /data/init.sh &
elif [ -x /data/elite_watchdog.sh ]; then
    /data/elite_watchdog.sh &
elif [ -x /data/elite_ui ]; then
    /data/elite_ui > /tmp/elite_ui.log 2>&1 &
fi

exit 0
