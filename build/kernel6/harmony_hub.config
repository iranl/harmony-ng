# Merged over arch/mips/configs/ath79_defconfig by build/build_kernel6.sh.
# Size budget: the kernel/kernel2 partitions hold 960 KB (0xF0000). Built in: only what is needed
# to boot and mount a root file system from flash; everything else is a module.
CONFIG_LOCALVERSION="-harmony"
CONFIG_CC_OPTIMIZE_FOR_SIZE=y
CONFIG_MIPS_RAW_APPENDED_DTB=y
CONFIG_MIPS_CMDLINE_DTB_EXTEND=y
CONFIG_HZ_250=y
CONFIG_PANIC_TIMEOUT=5
CONFIG_PANIC_ON_OOPS=y
# BREAK + b on the serial console reboots a hung system without a power cycle
CONFIG_MAGIC_SYSRQ=y
CONFIG_MAGIC_SYSRQ_SERIAL=y
CONFIG_FUTEX=y
# CONFIG_PCI is not set
# CONFIG_DEBUG_FS is not set
# CONFIG_KEYS is not set
# CONFIG_SYSTEM_TRUSTED_KEYRING is not set
# CONFIG_ASYMMETRIC_KEY_TYPE is not set
# CONFIG_MAC80211_DEBUGFS is not set

# core features the Hub does not use
# CONFIG_KALLSYMS is not set
# CONFIG_IO_URING is not set
# CONFIG_PERF_EVENTS is not set
# CONFIG_BPF_SYSCALL is not set
# CONFIG_CGROUPS is not set
# CONFIG_NAMESPACES is not set
# CONFIG_AUDIT is not set
# CONFIG_PROFILING is not set
# CONFIG_SWAP is not set
# CONFIG_COMPACTION is not set
# CONFIG_MIGRATION is not set
CONFIG_SLUB_TINY=y
# CONFIG_COREDUMP is not set
# CONFIG_FHANDLE is not set
# CONFIG_POSIX_MQUEUE is not set
# CONFIG_CROSS_MEMORY_ATTACH is not set
# CONFIG_RSEQ is not set
# CONFIG_SYMBOLIC_ERRNAME is not set
# CONFIG_DEBUG_BUGVERBOSE is not set
# CONFIG_PTP_1588_CLOCK is not set
# CONFIG_ETHTOOL_NETLINK is not set
# CONFIG_IP_ADVANCED_ROUTER is not set
# CONFIG_INET_DIAG is not set
# CONFIG_NETWORK_FILESYSTEMS is not set
# CONFIG_STACKPROTECTOR is not set
# CONFIG_DEVPORT is not set
# CONFIG_LEGACY_TIOCSTI is not set
# CONFIG_PPS is not set
CONFIG_PARTITION_ADVANCED=y
# CONFIG_MSDOS_PARTITION is not set
# CONFIG_EFI_PARTITION is not set
# CONFIG_MQ_IOSCHED_DEADLINE is not set
# CONFIG_MQ_IOSCHED_KYBER is not set
# CONFIG_RD_BZIP2 is not set
# CONFIG_RD_LZMA is not set
# CONFIG_RD_LZO is not set
# CONFIG_RD_LZ4 is not set
# CONFIG_RD_ZSTD is not set
# CONFIG_XZ_DEC_X86 is not set
# CONFIG_XZ_DEC_POWERPC is not set
# CONFIG_XZ_DEC_ARM is not set
# CONFIG_XZ_DEC_ARMTHUMB is not set
# CONFIG_XZ_DEC_ARM64 is not set
# CONFIG_XZ_DEC_SPARC is not set
# CONFIG_XZ_DEC_RISCV is not set

# devices and file systems
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y
CONFIG_TMPFS=y
CONFIG_BLK_DEV_INITRD=y
CONFIG_RD_XZ=y
CONFIG_SQUASHFS=y
CONFIG_SQUASHFS_XZ=y
# CONFIG_SQUASHFS_ZLIB is not set
CONFIG_JFFS2_FS=y
CONFIG_OVERLAY_FS=y

# flash: SPI NOR only, partitions from the device tree
CONFIG_MTD_OF_PARTS=y
# CONFIG_MTD_REDBOOT_PARTS is not set
# CONFIG_MTD_CMDLINE_PARTS is not set
# 64 KB erase blocks like the stock kernel: the stock JFFS2 partitions need them
# CONFIG_MTD_SPI_NOR_USE_4K_SECTORS is not set
# CONFIG_MTD_CFI is not set
# CONFIG_MTD_JEDECPROBE is not set
# CONFIG_MTD_PHYSMAP is not set
# CONFIG_MTD_COMPLEX_MAPPINGS is not set

# the AR9330 has only its own UART
# CONFIG_SERIAL_8250 is not set
# CONFIG_I2C is not set
# CONFIG_SPI_GPIO is not set
# CONFIG_GPIO_PCF857X is not set
CONFIG_SPI_SPIDEV=m
CONFIG_GPIO_CDEV=y
CONFIG_ATH79_WDT=y

# USB: ChipIdea controller, device mode by default; all modules
CONFIG_USB=m
CONFIG_PHY_ATH79_USB=m
CONFIG_USB_CHIPIDEA=m
CONFIG_USB_CHIPIDEA_UDC=y
CONFIG_USB_CHIPIDEA_HOST=y
CONFIG_USB_CHIPIDEA_GENERIC=m
# CONFIG_USB_OHCI_HCD is not set
CONFIG_USB_GADGET=m
CONFIG_USB_CONFIGFS=m
CONFIG_USB_CONFIGFS_RNDIS=y
CONFIG_USB_CONFIGFS_ECM=y
CONFIG_USB_CONFIGFS_F_HID=y
CONFIG_USB_ETH=m
CONFIG_USB_ETH_RNDIS=y

# USB host mode: USB Ethernet adapters and USB sticks (all modules)
CONFIG_USB_NET_DRIVERS=m
CONFIG_USB_USBNET=m
CONFIG_USB_RTL8152=m
CONFIG_USB_NET_AX8817X=m
CONFIG_USB_NET_AX88179_178A=m
CONFIG_USB_NET_CDCETHER=m
CONFIG_USB_NET_CDC_NCM=m
CONFIG_USB_NET_SMSC95XX=m
CONFIG_SCSI=m
CONFIG_BLK_DEV_SD=m
CONFIG_USB_STORAGE=m
CONFIG_FAT_FS=m
CONFIG_VFAT_FS=m
CONFIG_NLS_CODEPAGE_437=m
CONFIG_NLS_ISO8859_1=m

# Hub Pro 2400 Ethernet: AR9331 MACs (ag71xx) and the internal switch (DSA)
CONFIG_NET_VENDOR_ATHEROS=y
CONFIG_AG71XX=m
CONFIG_NET_DSA=m
CONFIG_NET_DSA_AR9331=m

# input and LEDs (buttons, status LED): modules
CONFIG_INPUT=m
CONFIG_INPUT_EVDEV=m
CONFIG_KEYBOARD_GPIO=m
CONFIG_NEW_LEDS=y
CONFIG_LEDS_CLASS=m
CONFIG_LEDS_GPIO=m

# Wi-Fi (AR9330 WMAC) and Bluetooth (CSR8811 over BCSP on the UART), modules for phase 5
# mac80211 asks for its ciphers by name (ccm(aes) for WPA2-CCMP, cmac for PMF, gcm): built in,
# as modules nothing loaded them and key installation failed with ENOENT
CONFIG_CRYPTO_AEAD=y
CONFIG_CRYPTO_SKCIPHER=y
CONFIG_CRYPTO_HASH=y
CONFIG_CRYPTO_AES=y
CONFIG_CRYPTO_CTR=y
CONFIG_CRYPTO_CCM=y
CONFIG_CRYPTO_CMAC=y
CONFIG_CRYPTO_GCM=y
CONFIG_CRYPTO_GHASH=y
CONFIG_CFG80211_CERTIFICATION_ONUS=y
# CONFIG_CFG80211_REQUIRE_SIGNED_REGDB is not set
CONFIG_ATH9K=m
CONFIG_ATH9K_AHB=y
CONFIG_BT=m
CONFIG_BT_HCIUART=m
CONFIG_BT_HCIUART_BCSP=y
